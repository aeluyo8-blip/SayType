<?xml version="1.0" encoding="utf-8"?>
<!-- 冰透玻璃球：白→浅蓝径向 + 高光 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="48dp"
                android:centerX="30%"
                android:centerY="18%"
                android:startColor="#FFFFFF"
                android:centerColor="#F3F8FD"
                android:endColor="#DBE7F6" />
            <stroke android:width="1dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- 顶部高光 -->
    <item android:top="6dp" android:left="10dp" android:right="18dp" android:bottom="36dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="20dp"
                android:startColor="#CCE0F5"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
